with "config/awklib_tests_config.gpr";
project Awklib_Tests is

   for Source_Dirs use ("src", "config");
   for Object_Dir use "obj/" & Awklib_Tests_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Exec_Dir use "bin";
   for Main use ("awklib_tests.adb");

   package Compiler is
      for Default_Switches ("Ada") use
        Awklib_Tests_Config.Ada_Compiler_Switches & ("-gnat2022", "-gnatyM120", "-gnata");
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es"); --  Symbolic traceback
   end Binder;

end Awklib_Tests;
