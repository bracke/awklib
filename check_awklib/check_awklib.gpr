with "config/check_awklib_config.gpr";
project Check_Awklib is

   for Source_Dirs use ("src/", "config/");
   for Object_Dir use "obj/" & Check_Awklib_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Exec_Dir use "bin";
   for Main use ("check_awklib.adb");

   package Compiler is
      for Default_Switches ("Ada") use
        Check_Awklib_Config.Ada_Compiler_Switches & ("-gnat2022", "-gnatyM120", "-gnata");
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es"); --  Symbolic traceback
   end Binder;

end Check_Awklib;
